document.getElementById('cep_usuario').addEventListener('blur', function () {

    const cep = this.value.replace(/\D/g, '');

    if (cep.length === 8) {
        const url = `https://viacep.com.br/ws/${cep}/json/`;

        fetch(url)
            .then(resposta => resposta.json())
            .then(dados => {
                if (dados.erro) {
                    alert('CEP não encontrado!');
                } else {
                    document.getElementById('endereco_usuario').value = dados.logradouro;
                    document.getElementById('bairro_usuario').value = dados.bairro;
                    document.getElementById('cidade_usuario').value = dados.localidade;
                    document.getElementById('uf_usuario').value = dados.uf;

                    document.getElementById('numero_endereco').value = focus();
                }
            })
            .catch(() => {
                alert('Erro ao consultar o CEP. Tente novamente.');
            });
    } else {
        alert('CEP inválido! Digite 8 números.');
    }
});